{
  "entities": {
    "Subscriber": {
      "title": "Subscriber",
      "description": "User who opted in for updates",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "description": "Where the subscription came from (e.g. reading)"
        }
      },
      "required": [
        "email",
        "subscribedAt"
      ]
    }
  },
  "firestore": {
    "/subscribers/{email}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers"
    }
  }
}
