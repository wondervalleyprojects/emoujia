# Gemini API Key (Get at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Email Configuration (Nodemailer Gmail SMTP)
# GMAIL_USER should be your PRIMARY Gmail address.
GMAIL_USER=
# GMAIL_APP_PASSWORD must be a 16-character App Password generated in Google Account settings.
GMAIL_APP_PASSWORD=

# Base URL for the application (used in emails and share cards)
VITE_APP_URL=

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Firebase service account (Project settings > Service accounts). Lets the
# server write subscribers as an admin and run the export. Copy two fields
# from the key file: client_email and private_key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or the whole key file instead (raw or base64). Too big for Netlify's 4KB limit.
FIREBASE_SERVICE_ACCOUNT=

# Subscriber export. The /api/admin/export-subscribers endpoint is closed
# unless EXPORT_SECRET is set; callers send "Authorization: Bearer <secret>".
EXPORT_SECRET=
# Where the scheduled CSV email goes (defaults to GMAIL_USER).
EXPORT_TO=
# Where replies to reading emails go (defaults to emoujia@wondervalleyprojects.com, which reaches Japhy).
REPLY_TO=

# Shapiro webfonts, fetched at build from a private repo (see docs/OPERATIONS.md).
FONTS_TOKEN=
# FONTS_REPO defaults to wondervalleyprojects/wvp-brand-fonts
